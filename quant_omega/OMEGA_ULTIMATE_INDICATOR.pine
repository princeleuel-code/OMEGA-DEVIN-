// ============================================================================
// OMEGA ULTIMATE INDICATOR - THE BEST INDICATOR THE WORLD HAS EVER SEEN
// ============================================================================
// Version: 2.0.0 ULTIMATE
// Author: OMEGA-DEVIN System
// 
// This indicator combines:
// - Trader Kane's $2.3M methodology (50% Rule, PO3, SMT Divergence)
// - ICT/SMC concepts (Order Blocks, Fair Value Gaps, Liquidity Sweeps)
// - Multi-timeframe confluence (Daily + H4 + H1 alignment)
// - Institutional order flow detection
// - Market structure analysis (BOS, CHOCH, Swing Points)
// - Kill zone timing (London, NY, Asia sessions)
// - AI-style market narrative generation
//
// NON-REPAINTING - All signals confirmed on bar close
// ============================================================================

//@version=5
indicator("OMEGA ULTIMATE - The Best Indicator Ever", 
     shorttitle="OMEGA ULTIMATE", 
     overlay=true,
     max_labels_count=500,
     max_lines_count=500,
     max_boxes_count=500)

// ============================================================================
// INPUTS - ORGANIZED BY CATEGORY
// ============================================================================

// === GENERAL SETTINGS ===
i_nonRepaint = input.bool(true, "Non-Repainting Mode", group="General", tooltip="When ON, all signals are confirmed on bar close")
i_showDashboard = input.bool(true, "Show Dashboard", group="General")
i_showNarrative = input.bool(true, "Show Market Narrative", group="General")
i_alertsOn = input.bool(true, "Enable Alerts", group="General")

// === MARKET STRUCTURE ===
i_swingLength = input.int(5, "Swing Detection Length", minval=2, maxval=20, group="Market Structure")
i_showSwings = input.bool(true, "Show Swing Points", group="Market Structure")
i_showBOS = input.bool(true, "Show BOS/CHOCH", group="Market Structure")
i_showStructureLabels = input.bool(true, "Show Structure Labels", group="Market Structure")

// === ORDER BLOCKS ===
i_showOB = input.bool(true, "Show Order Blocks", group="Order Blocks")
i_obLookback = input.int(50, "OB Lookback", minval=10, maxval=200, group="Order Blocks")
i_obMitigation = input.bool(true, "Show Mitigated OBs", group="Order Blocks")
i_obBullColor = input.color(color.new(color.green, 80), "Bullish OB Color", group="Order Blocks")
i_obBearColor = input.color(color.new(color.red, 80), "Bearish OB Color", group="Order Blocks")

// === FAIR VALUE GAPS ===
i_showFVG = input.bool(true, "Show Fair Value Gaps", group="Fair Value Gaps")
i_fvgLookback = input.int(50, "FVG Lookback", minval=10, maxval=200, group="Fair Value Gaps")
i_fvgMinSize = input.float(0.1, "Min FVG Size %", minval=0.01, maxval=1.0, step=0.01, group="Fair Value Gaps")
i_fvgBullColor = input.color(color.new(color.teal, 80), "Bullish FVG Color", group="Fair Value Gaps")
i_fvgBearColor = input.color(color.new(color.maroon, 80), "Bearish FVG Color", group="Fair Value Gaps")

// === LIQUIDITY ===
i_showLiquidity = input.bool(true, "Show Liquidity Levels", group="Liquidity")
i_liqLookback = input.int(20, "Liquidity Lookback", minval=5, maxval=100, group="Liquidity")
i_showLiqSweep = input.bool(true, "Show Liquidity Sweeps", group="Liquidity")
i_liqColor = input.color(color.new(color.orange, 50), "Liquidity Color", group="Liquidity")

// === 50% EQUILIBRIUM (TRADER KANE) ===
i_show50Pct = input.bool(true, "Show 50% Equilibrium", group="50% Rule")
i_eqLookback = input.int(20, "Equilibrium Lookback", minval=5, maxval=100, group="50% Rule")
i_eqColor = input.color(color.new(color.purple, 50), "Equilibrium Color", group="50% Rule")

// === PO3 (POWER OF THREE) ===
i_showPO3 = input.bool(true, "Show PO3 Phases", group="PO3")
i_po3SessionStart = input.int(0, "Session Start Hour (UTC)", minval=0, maxval=23, group="PO3")
i_po3AccumHours = input.int(4, "Accumulation Hours", minval=1, maxval=8, group="PO3")
i_po3ManipHours = input.int(2, "Manipulation Hours", minval=1, maxval=4, group="PO3")

// === SMT DIVERGENCE ===
i_showSMT = input.bool(true, "Show SMT Divergence", group="SMT Divergence")
i_smtSymbol = input.symbol("ES1!", "Correlated Symbol", group="SMT Divergence")
i_smtLookback = input.int(10, "SMT Lookback", minval=3, maxval=30, group="SMT Divergence")

// === KILL ZONES ===
i_showKillZones = input.bool(true, "Show Kill Zones", group="Kill Zones")
i_londonStart = input.int(8, "London Start (UTC)", minval=0, maxval=23, group="Kill Zones")
i_londonEnd = input.int(11, "London End (UTC)", minval=0, maxval=23, group="Kill Zones")
i_nyStart = input.int(13, "NY Start (UTC)", minval=0, maxval=23, group="Kill Zones")
i_nyEnd = input.int(16, "NY End (UTC)", minval=0, maxval=23, group="Kill Zones")
i_asiaStart = input.int(0, "Asia Start (UTC)", minval=0, maxval=23, group="Kill Zones")
i_asiaEnd = input.int(3, "Asia End (UTC)", minval=0, maxval=23, group="Kill Zones")

// === MULTI-TIMEFRAME ===
i_useMTF = input.bool(true, "Use Multi-Timeframe Analysis", group="Multi-Timeframe")
i_htf1 = input.timeframe("240", "Higher TF 1 (H4)", group="Multi-Timeframe")
i_htf2 = input.timeframe("D", "Higher TF 2 (Daily)", group="Multi-Timeframe")

// === CONFLUENCE SCORING ===
i_confThreshold = input.int(70, "Confluence Threshold", minval=50, maxval=100, group="Confluence")
i_showConfluence = input.bool(true, "Show Confluence Score", group="Confluence")

// === REGIME DETECTION ===
i_adxPeriod = input.int(14, "ADX Period", minval=5, maxval=50, group="Regime")
i_adxThreshold = input.int(25, "ADX Trend Threshold", minval=15, maxval=40, group="Regime")
i_atrPeriod = input.int(14, "ATR Period", minval=5, maxval=50, group="Regime")

// === VISUAL SETTINGS ===
i_bullColor = input.color(color.green, "Bullish Color", group="Visual")
i_bearColor = input.color(color.red, "Bearish Color", group="Visual")
i_neutralColor = input.color(color.gray, "Neutral Color", group="Visual")

// ============================================================================
// HELPER FUNCTIONS
// ============================================================================

// Non-repainting confirmation
confirmed(src) => i_nonRepaint ? src[1] : src

// True Range
tr_() => math.max(high - low, math.abs(high - close[1]), math.abs(low - close[1]))

// ATR
atr_(length) => ta.rma(tr_(), length)

// ADX
adx_(length) =>
    up = ta.change(high)
    down = -ta.change(low)
    plusDM = na(up) ? na : (up > down and up > 0 ? up : 0)
    minusDM = na(down) ? na : (down > up and down > 0 ? down : 0)
    trueRange = tr_()
    plusDI = 100 * ta.rma(plusDM, length) / ta.rma(trueRange, length)
    minusDI = 100 * ta.rma(minusDM, length) / ta.rma(trueRange, length)
    dx = 100 * math.abs(plusDI - minusDI) / (plusDI + minusDI)
    adxVal = ta.rma(dx, length)
    [adxVal, plusDI, minusDI]

// RSI
rsi_(src, length) => ta.rsi(src, length)

// ============================================================================
// MARKET STRUCTURE DETECTION
// ============================================================================

// Swing High/Low Detection
pivotHigh = ta.pivothigh(high, i_swingLength, i_swingLength)
pivotLow = ta.pivotlow(low, i_swingLength, i_swingLength)

// Track swing points
var float lastSwingHigh = na
var float lastSwingLow = na
var int lastSwingHighBar = na
var int lastSwingLowBar = na
var float prevSwingHigh = na
var float prevSwingLow = na

if not na(pivotHigh)
    prevSwingHigh := lastSwingHigh
    lastSwingHigh := pivotHigh
    lastSwingHighBar := bar_index - i_swingLength

if not na(pivotLow)
    prevSwingLow := lastSwingLow
    lastSwingLow := pivotLow
    lastSwingLowBar := bar_index - i_swingLength

// Market Structure Classification
var string marketStructure = "NEUTRAL"
var string lastBOS = "NONE"

// Higher High / Higher Low / Lower High / Lower Low
isHH = not na(pivotHigh) and pivotHigh > prevSwingHigh
isHL = not na(pivotLow) and pivotLow > prevSwingLow
isLH = not na(pivotHigh) and pivotHigh < prevSwingHigh
isLL = not na(pivotLow) and pivotLow < prevSwingLow

// Break of Structure (BOS) - Continuation
bullishBOS = close > lastSwingHigh and close[1] <= lastSwingHigh
bearishBOS = close < lastSwingLow and close[1] >= lastSwingLow

// Change of Character (CHOCH) - Reversal
bullishCHOCH = marketStructure == "BEARISH" and close > lastSwingHigh
bearishCHOCH = marketStructure == "BULLISH" and close < lastSwingLow

// Update market structure
if isHH and isHL
    marketStructure := "BULLISH"
if isLH and isLL
    marketStructure := "BEARISH"

// Track BOS/CHOCH
if bullishBOS
    lastBOS := "BULL_BOS"
if bearishBOS
    lastBOS := "BEAR_BOS"
if bullishCHOCH
    lastBOS := "BULL_CHOCH"
if bearishCHOCH
    lastBOS := "BEAR_CHOCH"

// Plot swing points
plotshape(i_showSwings and not na(pivotHigh), title="Swing High", location=location.abovebar, 
          color=i_bearColor, style=shape.triangledown, size=size.tiny, offset=-i_swingLength)
plotshape(i_showSwings and not na(pivotLow), title="Swing Low", location=location.belowbar, 
          color=i_bullColor, style=shape.triangleup, size=size.tiny, offset=-i_swingLength)

// Plot BOS/CHOCH labels
if i_showBOS and bullishBOS
    label.new(bar_index, low, "BOS", color=i_bullColor, textcolor=color.white, 
              style=label.style_label_up, size=size.tiny)
if i_showBOS and bearishBOS
    label.new(bar_index, high, "BOS", color=i_bearColor, textcolor=color.white, 
              style=label.style_label_down, size=size.tiny)
if i_showBOS and bullishCHOCH
    label.new(bar_index, low, "CHOCH", color=color.lime, textcolor=color.white, 
              style=label.style_label_up, size=size.small)
if i_showBOS and bearishCHOCH
    label.new(bar_index, high, "CHOCH", color=color.fuchsia, textcolor=color.white, 
              style=label.style_label_down, size=size.small)

// ============================================================================
// ORDER BLOCK DETECTION
// ============================================================================

// Bullish Order Block: Last down candle before a strong up move
// Bearish Order Block: Last up candle before a strong down move

var box[] bullOBs = array.new_box()
var box[] bearOBs = array.new_box()

// Detect bullish OB
bullishOB = close[2] < open[2] and  // Down candle
            close[1] > open[1] and  // Up candle
            close > high[2] and     // Break above down candle high
            (close - open[1]) > 1.5 * atr_(i_atrPeriod)  // Strong move

// Detect bearish OB
bearishOB = close[2] > open[2] and  // Up candle
            close[1] < open[1] and  // Down candle
            close < low[2] and      // Break below up candle low
            (open[1] - close) > 1.5 * atr_(i_atrPeriod)  // Strong move

// Draw Order Blocks
if i_showOB and bullishOB
    obBox = box.new(bar_index - 2, high[2], bar_index + 20, low[2], 
                    bgcolor=i_obBullColor, border_color=color.green, border_width=1)
    array.push(bullOBs, obBox)
    if array.size(bullOBs) > 10
        box.delete(array.shift(bullOBs))

if i_showOB and bearishOB
    obBox = box.new(bar_index - 2, high[2], bar_index + 20, low[2], 
                    bgcolor=i_obBearColor, border_color=color.red, border_width=1)
    array.push(bearOBs, obBox)
    if array.size(bearOBs) > 10
        box.delete(array.shift(bearOBs))

// ============================================================================
// FAIR VALUE GAP DETECTION
// ============================================================================

var box[] bullFVGs = array.new_box()
var box[] bearFVGs = array.new_box()

// Bullish FVG: Gap between candle 1 high and candle 3 low (in uptrend)
fvgBullGap = low - high[2]
bullishFVG = fvgBullGap > 0 and fvgBullGap / close * 100 > i_fvgMinSize

// Bearish FVG: Gap between candle 1 low and candle 3 high (in downtrend)
fvgBearGap = low[2] - high
bearishFVG = fvgBearGap > 0 and fvgBearGap / close * 100 > i_fvgMinSize

// Draw FVGs
if i_showFVG and bullishFVG
    fvgBox = box.new(bar_index - 1, low, bar_index + 20, high[2], 
                     bgcolor=i_fvgBullColor, border_color=color.teal, border_width=1)
    array.push(bullFVGs, fvgBox)
    if array.size(bullFVGs) > 10
        box.delete(array.shift(bullFVGs))

if i_showFVG and bearishFVG
    fvgBox = box.new(bar_index - 1, low[2], bar_index + 20, high, 
                     bgcolor=i_fvgBearColor, border_color=color.maroon, border_width=1)
    array.push(bearFVGs, fvgBox)
    if array.size(bearFVGs) > 10
        box.delete(array.shift(bearFVGs))

// ============================================================================
// LIQUIDITY DETECTION
// ============================================================================

// Equal Highs/Lows (Liquidity Pools)
equalHighs = math.abs(high - high[1]) < atr_(i_atrPeriod) * 0.1 and 
             math.abs(high - high[2]) < atr_(i_atrPeriod) * 0.1

equalLows = math.abs(low - low[1]) < atr_(i_atrPeriod) * 0.1 and 
            math.abs(low - low[2]) < atr_(i_atrPeriod) * 0.1

// Liquidity Sweep Detection
highestHigh = ta.highest(high, i_liqLookback)
lowestLow = ta.lowest(low, i_liqLookback)

// Sweep above highs then close back below
bullLiqSweep = high > highestHigh[1] and close < highestHigh[1]

// Sweep below lows then close back above
bearLiqSweep = low < lowestLow[1] and close > lowestLow[1]

// Plot liquidity sweeps
plotshape(i_showLiqSweep and bullLiqSweep, title="Bull Liq Sweep", 
          location=location.abovebar, color=color.orange, style=shape.diamond, size=size.small)
plotshape(i_showLiqSweep and bearLiqSweep, title="Bear Liq Sweep", 
          location=location.belowbar, color=color.orange, style=shape.diamond, size=size.small)

// Draw liquidity levels
var line liqHighLine = na
var line liqLowLine = na

if i_showLiquidity and barstate.islast
    line.delete(liqHighLine)
    line.delete(liqLowLine)
    liqHighLine := line.new(bar_index - i_liqLookback, highestHigh, bar_index, highestHigh, 
                            color=i_liqColor, style=line.style_dashed, width=2)
    liqLowLine := line.new(bar_index - i_liqLookback, lowestLow, bar_index, lowestLow, 
                           color=i_liqColor, style=line.style_dashed, width=2)

// ============================================================================
// 50% EQUILIBRIUM (TRADER KANE'S RULE)
// ============================================================================

// Price ALWAYS redelivers to 50% of the range
rangeHigh = ta.highest(high, i_eqLookback)
rangeLow = ta.lowest(low, i_eqLookback)
equilibrium = (rangeHigh + rangeLow) / 2

// Premium zone (above 50%)
premiumZone = close > equilibrium

// Discount zone (below 50%)
discountZone = close < equilibrium

// Plot equilibrium
plot(i_show50Pct ? equilibrium : na, "50% Equilibrium", color=i_eqColor, linewidth=2, style=plot.style_circles)

// Premium/Discount zones
bgcolor(i_show50Pct and premiumZone ? color.new(color.red, 95) : na, title="Premium Zone")
bgcolor(i_show50Pct and discountZone ? color.new(color.green, 95) : na, title="Discount Zone")

// ============================================================================
// PO3 - POWER OF THREE (ACCUMULATION → MANIPULATION → DISTRIBUTION)
// ============================================================================

// Session-based PO3 detection
currentHour = hour(time, "UTC")
sessionHour = (currentHour - i_po3SessionStart + 24) % 24

// PO3 Phases
isAccumulation = sessionHour < i_po3AccumHours
isManipulation = sessionHour >= i_po3AccumHours and sessionHour < (i_po3AccumHours + i_po3ManipHours)
isDistribution = sessionHour >= (i_po3AccumHours + i_po3ManipHours)

// PO3 Phase string
po3Phase = isAccumulation ? "ACCUMULATION" : isManipulation ? "MANIPULATION" : "DISTRIBUTION"

// Color based on phase
po3Color = isAccumulation ? color.new(color.blue, 90) : 
           isManipulation ? color.new(color.orange, 90) : 
           color.new(color.purple, 90)

bgcolor(i_showPO3 ? po3Color : na, title="PO3 Phase")

// ============================================================================
// SMT DIVERGENCE (ES vs NQ style)
// ============================================================================

// Get correlated symbol data
[smtOpen, smtHigh, smtLow, smtClose] = request.security(i_smtSymbol, timeframe.period, 
    [open, high, low, close], lookahead=barmerge.lookahead_off)

// Detect divergence
// Bullish SMT: Current makes lower low, correlated makes higher low
// Bearish SMT: Current makes higher high, correlated makes lower high

currentLL = low < ta.lowest(low, i_smtLookback)[1]
currentHH = high > ta.highest(high, i_smtLookback)[1]

smtHL = smtLow > ta.lowest(smtLow, i_smtLookback)[1]
smtLH = smtHigh < ta.highest(smtHigh, i_smtLookback)[1]

bullishSMT = currentLL and smtHL  // Current weak, correlated strong
bearishSMT = currentHH and smtLH  // Current strong, correlated weak

// Plot SMT
plotshape(i_showSMT and bullishSMT, title="Bullish SMT", location=location.belowbar, 
          color=color.lime, style=shape.circle, size=size.small, text="SMT")
plotshape(i_showSMT and bearishSMT, title="Bearish SMT", location=location.abovebar, 
          color=color.fuchsia, style=shape.circle, size=size.small, text="SMT")

// ============================================================================
// KILL ZONES
// ============================================================================

inLondonKZ = currentHour >= i_londonStart and currentHour < i_londonEnd
inNYKZ = currentHour >= i_nyStart and currentHour < i_nyEnd
inAsiaKZ = currentHour >= i_asiaStart and currentHour < i_asiaEnd
inKillZone = inLondonKZ or inNYKZ or inAsiaKZ

killZoneColor = inLondonKZ ? color.new(color.blue, 95) : 
                inNYKZ ? color.new(color.green, 95) : 
                inAsiaKZ ? color.new(color.yellow, 95) : na

bgcolor(i_showKillZones ? killZoneColor : na, title="Kill Zone")

// ============================================================================
// MULTI-TIMEFRAME ANALYSIS
// ============================================================================

// Get HTF data
[htf1_close, htf1_high, htf1_low] = request.security(syminfo.tickerid, i_htf1, 
    [close, high, low], lookahead=barmerge.lookahead_off)
[htf2_close, htf2_high, htf2_low] = request.security(syminfo.tickerid, i_htf2, 
    [close, high, low], lookahead=barmerge.lookahead_off)

// HTF trend detection
htf1_ema = request.security(syminfo.tickerid, i_htf1, ta.ema(close, 21), lookahead=barmerge.lookahead_off)
htf2_ema = request.security(syminfo.tickerid, i_htf2, ta.ema(close, 21), lookahead=barmerge.lookahead_off)

htf1_bullish = htf1_close > htf1_ema
htf2_bullish = htf2_close > htf2_ema

htf1_trend = htf1_bullish ? "BULL" : "BEAR"
htf2_trend = htf2_bullish ? "BULL" : "BEAR"

// MTF Alignment
mtfAligned = (htf1_bullish and htf2_bullish) or (not htf1_bullish and not htf2_bullish)
mtfBullish = htf1_bullish and htf2_bullish
mtfBearish = not htf1_bullish and not htf2_bullish

// ============================================================================
// REGIME DETECTION
// ============================================================================

[adx, diPlus, diMinus] = adx_(i_adxPeriod)
atr = atr_(i_atrPeriod)
atrSlow = atr_(50)
atrRatio = atr / atrSlow

regime = adx > i_adxThreshold ? "TRENDING" : 
         atrRatio > 1.2 ? "VOLATILE" : 
         atrRatio < 0.8 ? "QUIET" : "RANGING"

trendDir = diPlus > diMinus ? 1 : -1

// ============================================================================
// CONFLUENCE SCORING (0-100)
// ============================================================================

calcConfluence() =>
    score = 0.0
    
    // Market Structure (0-20)
    if marketStructure == "BULLISH"
        score += 20
    else if marketStructure == "BEARISH"
        score += 20
    else
        score += 5
    
    // MTF Alignment (0-20)
    if mtfAligned
        score += 20
    else
        score += 5
    
    // Kill Zone (0-15)
    if inKillZone
        score += 15
    
    // Discount/Premium Zone (0-15)
    if (marketStructure == "BULLISH" and discountZone) or (marketStructure == "BEARISH" and premiumZone)
        score += 15
    else if (marketStructure == "BULLISH" and premiumZone) or (marketStructure == "BEARISH" and discountZone)
        score += 0  // Wrong zone
    else
        score += 7
    
    // Recent BOS/CHOCH (0-15)
    if lastBOS == "BULL_CHOCH" or lastBOS == "BEAR_CHOCH"
        score += 15
    else if lastBOS == "BULL_BOS" or lastBOS == "BEAR_BOS"
        score += 10
    
    // SMT Divergence (0-10)
    if bullishSMT or bearishSMT
        score += 10
    
    // Regime (0-5)
    if regime == "TRENDING"
        score += 5
    
    math.min(100, score)

confluence = calcConfluence()

// ============================================================================
// SIGNAL GENERATION
// ============================================================================

// Ultimate Long Signal
ultimateLong = marketStructure == "BULLISH" and
               mtfBullish and
               discountZone and
               inKillZone and
               confluence >= i_confThreshold and
               (bullishBOS or bullishCHOCH or bullLiqSweep or bullishSMT)

// Ultimate Short Signal
ultimateShort = marketStructure == "BEARISH" and
                mtfBearish and
                premiumZone and
                inKillZone and
                confluence >= i_confThreshold and
                (bearishBOS or bearishCHOCH or bearLiqSweep or bearishSMT)

// Confirmed signals
longSignal = confirmed(ultimateLong) and not confirmed(ultimateLong)[1]
shortSignal = confirmed(ultimateShort) and not confirmed(ultimateShort)[1]

// Plot signals
plotshape(longSignal, title="ULTIMATE LONG", location=location.belowbar, 
          color=color.lime, style=shape.labelup, size=size.large, text="LONG")
plotshape(shortSignal, title="ULTIMATE SHORT", location=location.abovebar, 
          color=color.red, style=shape.labeldown, size=size.large, text="SHORT")

// ============================================================================
// DASHBOARD
// ============================================================================

var table dashboard = table.new(position.top_right, 2, 15, bgcolor=color.new(color.black, 85), 
                                border_width=1, border_color=color.gray)

if i_showDashboard and barstate.islast
    // Header
    table.cell(dashboard, 0, 0, "OMEGA ULTIMATE", text_color=color.gold, text_size=size.normal, bgcolor=color.new(color.purple, 70))
    table.cell(dashboard, 1, 0, "v2.0", text_color=color.white, text_size=size.small, bgcolor=color.new(color.purple, 70))
    
    // Market Structure
    structColor = marketStructure == "BULLISH" ? color.green : marketStructure == "BEARISH" ? color.red : color.gray
    table.cell(dashboard, 0, 1, "Structure", text_color=color.gray, text_size=size.tiny)
    table.cell(dashboard, 1, 1, marketStructure, text_color=structColor, text_size=size.tiny)
    
    // Regime
    regimeColor = regime == "TRENDING" ? color.green : regime == "VOLATILE" ? color.orange : color.gray
    table.cell(dashboard, 0, 2, "Regime", text_color=color.gray, text_size=size.tiny)
    table.cell(dashboard, 1, 2, regime, text_color=regimeColor, text_size=size.tiny)
    
    // HTF1 Trend
    htf1Color = htf1_bullish ? color.green : color.red
    table.cell(dashboard, 0, 3, i_htf1 + " Trend", text_color=color.gray, text_size=size.tiny)
    table.cell(dashboard, 1, 3, htf1_trend, text_color=htf1Color, text_size=size.tiny)
    
    // HTF2 Trend
    htf2Color = htf2_bullish ? color.green : color.red
    table.cell(dashboard, 0, 4, i_htf2 + " Trend", text_color=color.gray, text_size=size.tiny)
    table.cell(dashboard, 1, 4, htf2_trend, text_color=htf2Color, text_size=size.tiny)
    
    // MTF Alignment
    mtfColor = mtfAligned ? color.green : color.orange
    table.cell(dashboard, 0, 5, "MTF Aligned", text_color=color.gray, text_size=size.tiny)
    table.cell(dashboard, 1, 5, mtfAligned ? "YES" : "NO", text_color=mtfColor, text_size=size.tiny)
    
    // Zone
    zoneText = premiumZone ? "PREMIUM" : "DISCOUNT"
    zoneColor = premiumZone ? color.red : color.green
    table.cell(dashboard, 0, 6, "Zone", text_color=color.gray, text_size=size.tiny)
    table.cell(dashboard, 1, 6, zoneText, text_color=zoneColor, text_size=size.tiny)
    
    // PO3 Phase
    po3TextColor = isAccumulation ? color.blue : isManipulation ? color.orange : color.purple
    table.cell(dashboard, 0, 7, "PO3 Phase", text_color=color.gray, text_size=size.tiny)
    table.cell(dashboard, 1, 7, po3Phase, text_color=po3TextColor, text_size=size.tiny)
    
    // Kill Zone
    kzText = inLondonKZ ? "LONDON" : inNYKZ ? "NEW YORK" : inAsiaKZ ? "ASIA" : "NONE"
    kzColor = inKillZone ? color.green : color.gray
    table.cell(dashboard, 0, 8, "Kill Zone", text_color=color.gray, text_size=size.tiny)
    table.cell(dashboard, 1, 8, kzText, text_color=kzColor, text_size=size.tiny)
    
    // Last BOS
    bosColor = str.contains(lastBOS, "BULL") ? color.green : str.contains(lastBOS, "BEAR") ? color.red : color.gray
    table.cell(dashboard, 0, 9, "Last BOS", text_color=color.gray, text_size=size.tiny)
    table.cell(dashboard, 1, 9, lastBOS, text_color=bosColor, text_size=size.tiny)
    
    // SMT Status
    smtText = bullishSMT ? "BULLISH" : bearishSMT ? "BEARISH" : "NONE"
    smtColor = bullishSMT ? color.lime : bearishSMT ? color.fuchsia : color.gray
    table.cell(dashboard, 0, 10, "SMT Div", text_color=color.gray, text_size=size.tiny)
    table.cell(dashboard, 1, 10, smtText, text_color=smtColor, text_size=size.tiny)
    
    // Confluence Score
    confColor = confluence >= 85 ? color.lime : confluence >= 70 ? color.green : confluence >= 50 ? color.yellow : color.red
    table.cell(dashboard, 0, 11, "Confluence", text_color=color.gray, text_size=size.tiny)
    table.cell(dashboard, 1, 11, str.tostring(math.round(confluence)) + "%", text_color=confColor, text_size=size.tiny)
    
    // Signal
    signalText = longSignal ? "LONG" : shortSignal ? "SHORT" : "WAIT"
    signalColor = longSignal ? color.lime : shortSignal ? color.red : color.gray
    table.cell(dashboard, 0, 12, "SIGNAL", text_color=color.white, text_size=size.small, bgcolor=color.new(signalColor, 50))
    table.cell(dashboard, 1, 12, signalText, text_color=color.white, text_size=size.small, bgcolor=color.new(signalColor, 50))

// ============================================================================
// MARKET NARRATIVE
// ============================================================================

var label narrativeLabel = na

if i_showNarrative and barstate.islast
    label.delete(narrativeLabel)
    
    // Build narrative
    narrative = ""
    
    // Structure narrative
    if marketStructure == "BULLISH"
        narrative := "Market is BULLISH (making HH/HL). "
    else if marketStructure == "BEARISH"
        narrative := "Market is BEARISH (making LH/LL). "
    else
        narrative := "Market is NEUTRAL (no clear structure). "
    
    // MTF narrative
    if mtfAligned
        if mtfBullish
            narrative := narrative + "All timeframes ALIGNED BULLISH. "
        else
            narrative := narrative + "All timeframes ALIGNED BEARISH. "
    else
        narrative := narrative + "Timeframes NOT aligned (caution). "
    
    // Zone narrative
    if premiumZone
        narrative := narrative + "Price in PREMIUM zone (above 50%). "
    else
        narrative := narrative + "Price in DISCOUNT zone (below 50%). "
    
    // PO3 narrative
    if isAccumulation
        narrative := narrative + "PO3: ACCUMULATION phase (building positions). "
    else if isManipulation
        narrative := narrative + "PO3: MANIPULATION phase (stop hunts likely). "
    else
        narrative := narrative + "PO3: DISTRIBUTION phase (trend moves). "
    
    // Kill zone narrative
    if inLondonKZ
        narrative := narrative + "LONDON session active. "
    else if inNYKZ
        narrative := narrative + "NEW YORK session active. "
    else if inAsiaKZ
        narrative := narrative + "ASIA session active. "
    
    // Signal narrative
    if confluence >= i_confThreshold
        if marketStructure == "BULLISH" and discountZone
            narrative := narrative + "\n\nLOOKING FOR LONGS in discount zone."
        else if marketStructure == "BEARISH" and premiumZone
            narrative := narrative + "\n\nLOOKING FOR SHORTS in premium zone."
        else
            narrative := narrative + "\n\nWAIT for better entry zone."
    else
        narrative := narrative + "\n\nCONFLUENCE TOO LOW (" + str.tostring(math.round(confluence)) + "%). WAIT."
    
    narrativeLabel := label.new(bar_index + 3, low - 3 * atr, narrative, 
                                color=color.new(color.black, 70), textcolor=color.white,
                                style=label.style_label_up, size=size.small, textalign=text.align_left)

// ============================================================================
// ALERTS
// ============================================================================

alertcondition(longSignal, title="ULTIMATE LONG", message="OMEGA ULTIMATE: LONG signal! Confluence: {{plot_0}}%")
alertcondition(shortSignal, title="ULTIMATE SHORT", message="OMEGA ULTIMATE: SHORT signal! Confluence: {{plot_0}}%")
alertcondition(bullishCHOCH, title="Bullish CHOCH", message="OMEGA ULTIMATE: Bullish Change of Character detected!")
alertcondition(bearishCHOCH, title="Bearish CHOCH", message="OMEGA ULTIMATE: Bearish Change of Character detected!")
alertcondition(bullLiqSweep, title="Bull Liquidity Sweep", message="OMEGA ULTIMATE: Bullish liquidity sweep detected!")
alertcondition(bearLiqSweep, title="Bear Liquidity Sweep", message="OMEGA ULTIMATE: Bearish liquidity sweep detected!")
alertcondition(bullishSMT, title="Bullish SMT", message="OMEGA ULTIMATE: Bullish SMT divergence detected!")
alertcondition(bearishSMT, title="Bearish SMT", message="OMEGA ULTIMATE: Bearish SMT divergence detected!")

// Plot confluence for alerts
plot(confluence, "Confluence", display=display.none)
