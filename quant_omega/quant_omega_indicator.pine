// QUANT-OMEGA: Adaptive Regime + Ensemble Signal Indicator
// Version: 1.0.0
// Author: OMEGA-DEVIN System
// License: MIT
// 
// This indicator detects market regime and generates ensemble signals
// from 3 independent alpha families with a unified confidence score.
// 
// FEATURES:
// - Regime Detection (Trend/Range/Breakout)
// - 3 Alpha Families (Trend Following, Mean Reversion, Breakout)
// - Confidence Score (0-100)
// - No-Trade Zone Detection
// - Non-Repainting Mode (default ON)

//@version=5
indicator("QUANT-OMEGA: Adaptive Regime + Ensemble Signal", 
     shorttitle="QUANT-OMEGA", 
     overlay=true,
     max_labels_count=500,
     max_lines_count=500)

// ============================================================================
// INPUTS
// ============================================================================

// General Settings
i_nonRepaint = input.bool(true, "Non-Repainting Mode", group="General")
i_showDebug = input.bool(false, "Show Debug Panel", group="General")
i_alertsOn = input.bool(true, "Enable Alerts", group="General")

// Regime Detection
i_adxPeriod = input.int(14, "ADX Period", minval=5, maxval=50, group="Regime Detection")
i_adxThreshold = input.int(25, "ADX Trend Threshold", minval=15, maxval=40, group="Regime Detection")
i_atrPeriod = input.int(14, "ATR Period", minval=5, maxval=50, group="Regime Detection")
i_atrSlowPeriod = input.int(50, "ATR Slow Period", minval=20, maxval=100, group="Regime Detection")

// Trend Following
i_emaFast = input.int(8, "EMA Fast", minval=3, maxval=20, group="Trend Following")
i_emaSlow = input.int(21, "EMA Slow", minval=10, maxval=50, group="Trend Following")
i_emaTrend = input.int(50, "EMA Trend", minval=20, maxval=200, group="Trend Following")

// Mean Reversion
i_bbPeriod = input.int(20, "Bollinger Period", minval=10, maxval=50, group="Mean Reversion")
i_bbStd = input.float(2.0, "Bollinger StdDev", minval=1.0, maxval=3.0, step=0.1, group="Mean Reversion")
i_rsiPeriod = input.int(14, "RSI Period", minval=5, maxval=30, group="Mean Reversion")

// Breakout
i_donchianPeriod = input.int(20, "Donchian Period", minval=10, maxval=50, group="Breakout")
i_squeezeKcMult = input.float(1.5, "Keltner Multiplier", minval=1.0, maxval=2.5, step=0.1, group="Breakout")

// Confidence Thresholds
i_confNoTrade = input.int(30, "No Trade Threshold", minval=0, maxval=50, group="Confidence")
i_confWatch = input.int(50, "Watch Only Threshold", minval=30, maxval=70, group="Confidence")
i_confSmall = input.int(70, "Small Entry Threshold", minval=50, maxval=85, group="Confidence")
i_confStrong = input.int(85, "Strong Entry Threshold", minval=70, maxval=100, group="Confidence")

// Visual Settings
i_showRegimeLabel = input.bool(true, "Show Regime Label", group="Visual")
i_showConfMeter = input.bool(true, "Show Confidence Meter", group="Visual")
i_showNoTradeZone = input.bool(true, "Show No-Trade Zone Shading", group="Visual")
i_entryMarkerSize = input.string("normal", "Entry Marker Size", options=["tiny", "small", "normal", "large"], group="Visual")

// ============================================================================
// HELPER FUNCTIONS
// ============================================================================

// Get confirmed value (non-repainting)
confirmed(src) => i_nonRepaint ? src[1] : src

// True Range
tr_custom() => math.max(high - low, math.abs(high - close[1]), math.abs(low - close[1]))

// ATR
atr_custom(length) =>
    ta.rma(tr_custom(), length)

// ADX Calculation
adx_custom(length) =>
    up = ta.change(high)
    down = -ta.change(low)
    plusDM = na(up) ? na : (up > down and up > 0 ? up : 0)
    minusDM = na(down) ? na : (down > up and down > 0 ? down : 0)
    trueRange = tr_custom()
    plusDI = 100 * ta.rma(plusDM, length) / ta.rma(trueRange, length)
    minusDI = 100 * ta.rma(minusDM, length) / ta.rma(trueRange, length)
    dx = 100 * math.abs(plusDI - minusDI) / (plusDI + minusDI)
    adx = ta.rma(dx, length)
    [adx, plusDI, minusDI]

// Stochastic
stoch_custom(length, smoothK, smoothD) =>
    k = ta.sma(ta.stoch(close, high, low, length), smoothK)
    d = ta.sma(k, smoothD)
    [k, d]

// ============================================================================
// REGIME DETECTION
// ============================================================================

// ADX for trend detection
[adx, diPlus, diMinus] = adx_custom(i_adxPeriod)
adx_conf = confirmed(adx)
diPlus_conf = confirmed(diPlus)
diMinus_conf = confirmed(diMinus)

// Trend strength classification
trendStrength = adx_conf > i_adxThreshold ? "TRENDING" : 
                adx_conf > i_adxThreshold - 5 ? "WEAK_TREND" : "RANGING"

// Trend direction
trendDirection = diPlus_conf > diMinus_conf ? 1 : -1

// ATR for volatility regime
atrFast = atr_custom(i_atrPeriod)
atrSlow = atr_custom(i_atrSlowPeriod)
atrRatio = confirmed(atrFast) / confirmed(atrSlow)

// Volatility classification
volRegime = atrRatio > 1.2 ? "HIGH_VOL" : 
            atrRatio < 0.8 ? "LOW_VOL" : "NORMAL_VOL"

volExpanding = atrRatio > 1.2 and confirmed(atrFast) > confirmed(atrFast[5])
volContracting = atrRatio < 0.8 and confirmed(atrFast) < confirmed(atrFast[5])

// RSI for momentum
rsi = ta.rsi(close, i_rsiPeriod)
rsi_conf = confirmed(rsi)

// Stochastic
[stochK, stochD] = stoch_custom(14, 3, 3)
stochK_conf = confirmed(stochK)

// Momentum regime
momentumRegime = rsi_conf > 70 and stochK_conf > 80 ? "OVERBOUGHT" :
                 rsi_conf < 30 and stochK_conf < 20 ? "OVERSOLD" : "NEUTRAL"

// Momentum exhaustion
momentumExhaustion = (rsi_conf > 70 and rsi_conf < confirmed(rsi[3])) or 
                     (rsi_conf < 30 and rsi_conf > confirmed(rsi[3]))

// Squeeze detection (Bollinger inside Keltner)
bbBasis = ta.sma(close, i_bbPeriod)
bbDev = i_bbStd * ta.stdev(close, i_bbPeriod)
bbUpper = bbBasis + bbDev
bbLower = bbBasis - bbDev

kcBasis = ta.ema(close, i_bbPeriod)
kcRange = i_squeezeKcMult * atr_custom(i_bbPeriod)
kcUpper = kcBasis + kcRange
kcLower = kcBasis - kcRange

squeezeOn = confirmed(bbLower) > confirmed(kcLower) and confirmed(bbUpper) < confirmed(kcUpper)
squeezeMomentum = confirmed(close) - (ta.highest(high, i_bbPeriod) + ta.lowest(low, i_bbPeriod)) / 2

// Combined regime
regime = squeezeOn ? "SQUEEZE" :
         trendStrength == "TRENDING" ? "TRENDING" :
         volExpanding ? "BREAKOUT" : "RANGING"

// ============================================================================
// ALPHA FAMILY 1: TREND FOLLOWING
// ============================================================================

emaFast = ta.ema(close, i_emaFast)
emaSlow = ta.ema(close, i_emaSlow)
emaTrend = ta.ema(close, i_emaTrend)

emaFast_conf = confirmed(emaFast)
emaSlow_conf = confirmed(emaSlow)
emaTrend_conf = confirmed(emaTrend)
close_conf = confirmed(close)

// Pullback detection (price within 0.5 ATR of fast EMA)
atr_conf = confirmed(atrFast)
pullbackToEma = math.abs(close_conf - emaFast_conf) < 0.5 * atr_conf

// Long trend signal
longTrendSignal = emaFast_conf > emaSlow_conf and
                  close_conf > emaTrend_conf and
                  adx_conf > i_adxThreshold and
                  pullbackToEma and
                  rsi_conf > 40 and rsi_conf < 70

// Short trend signal
shortTrendSignal = emaFast_conf < emaSlow_conf and
                   close_conf < emaTrend_conf and
                   adx_conf > i_adxThreshold and
                   pullbackToEma and
                   rsi_conf < 60 and rsi_conf > 30

// ============================================================================
// ALPHA FAMILY 2: MEAN REVERSION
// ============================================================================

bbUpper_conf = confirmed(bbUpper)
bbLower_conf = confirmed(bbLower)
bbBasis_conf = confirmed(bbBasis)

// Volume confirmation
volSma = ta.sma(volume, 20)
volAboveAvg = confirmed(volume) > confirmed(volSma)

// EMA slope for trend filter
emaTrendSlope = (emaTrend_conf - confirmed(emaTrend[10])) / confirmed(emaTrend[10])

// Long reversion signal
longReversionSignal = close_conf < bbLower_conf and
                      adx_conf < i_adxThreshold and
                      rsi_conf < 30 and
                      volAboveAvg and
                      emaTrendSlope > -0.001

// Short reversion signal
shortReversionSignal = close_conf > bbUpper_conf and
                       adx_conf < i_adxThreshold and
                       rsi_conf > 70 and
                       volAboveAvg and
                       emaTrendSlope < 0.001

// ============================================================================
// ALPHA FAMILY 3: BREAKOUT
// ============================================================================

donchianHigh = ta.highest(high, i_donchianPeriod)
donchianLow = ta.lowest(low, i_donchianPeriod)

donchianHigh_conf = confirmed(donchianHigh[1])
donchianLow_conf = confirmed(donchianLow[1])

// Volume spike
volSpike = confirmed(volume) > 1.5 * confirmed(volSma)

// Long breakout signal
longBreakoutSignal = close_conf > donchianHigh_conf and
                     not squeezeOn and
                     confirmed(squeezeMomentum) > 0 and
                     volSpike and
                     atrRatio > 1.0

// Short breakout signal
shortBreakoutSignal = close_conf < donchianLow_conf and
                      not squeezeOn and
                      confirmed(squeezeMomentum) < 0 and
                      volSpike and
                      atrRatio > 1.0

// ============================================================================
// CONFIDENCE SCORE CALCULATION
// ============================================================================

calcConfidence() =>
    score = 0.0
    
    // Regime alignment (0-30 points)
    if regime == "TRENDING" and (longTrendSignal or shortTrendSignal)
        score += 30
    else if regime == "RANGING" and (longReversionSignal or shortReversionSignal)
        score += 30
    else if regime == "BREAKOUT" and (longBreakoutSignal or shortBreakoutSignal)
        score += 30
    else if longTrendSignal or shortTrendSignal or longReversionSignal or shortReversionSignal or longBreakoutSignal or shortBreakoutSignal
        score += 10
    
    // Signal agreement (0-30 points)
    longSignals = (longTrendSignal ? 1 : 0) + (longReversionSignal ? 1 : 0) + (longBreakoutSignal ? 1 : 0)
    shortSignals = (shortTrendSignal ? 1 : 0) + (shortReversionSignal ? 1 : 0) + (shortBreakoutSignal ? 1 : 0)
    signalCount = math.max(longSignals, shortSignals)
    
    if signalCount >= 2
        score += 30
    else if signalCount == 1
        score += 15
    
    // Volume confirmation (0-15 points)
    if confirmed(volume) > confirmed(volSma) * 1.2
        score += 15
    else if confirmed(volume) > confirmed(volSma)
        score += 10
    
    // Momentum alignment (0-15 points)
    if not momentumExhaustion
        score += 15
    
    // Volatility alignment (0-10 points)
    if volRegime != "LOW_VOL"
        score += 10
    
    math.min(100, score)

confidence = calcConfidence()

// ============================================================================
// NO-TRADE FILTERS
// ============================================================================

noTradeConditions = adx_conf < 15 or
                    atrRatio < 0.5 or
                    confirmed(volume) < 0.5 * confirmed(volSma)

finalConfidence = noTradeConditions ? 0 : confidence

// ============================================================================
// SIGNAL GENERATION
// ============================================================================

// Direction determination
longSignal = (longTrendSignal or longReversionSignal or longBreakoutSignal) and finalConfidence > i_confWatch
shortSignal = (shortTrendSignal or shortReversionSignal or shortBreakoutSignal) and finalConfidence > i_confWatch

// Entry signals (only on new signals)
longEntry = longSignal and not longSignal[1]
shortEntry = shortSignal and not shortSignal[1]

// Signal strength
signalStrength = finalConfidence >= i_confStrong ? "STRONG" :
                 finalConfidence >= i_confSmall ? "NORMAL" :
                 finalConfidence > i_confWatch ? "SMALL" : "NONE"

// ============================================================================
// STOP LOSS AND TAKE PROFIT LEVELS
// ============================================================================

// Calculate levels based on ATR
stopDistance = 2 * atr_conf
tpDistance = 3 * atr_conf

longStopLevel = close_conf - stopDistance
longTpLevel = close_conf + tpDistance
shortStopLevel = close_conf + stopDistance
shortTpLevel = close_conf - tpDistance

// ============================================================================
// VISUAL ELEMENTS
// ============================================================================

// Regime label
var label regimeLabel = na
if i_showRegimeLabel and barstate.islast
    label.delete(regimeLabel)
    regimeColor = regime == "TRENDING" ? color.green :
                  regime == "BREAKOUT" ? color.orange :
                  regime == "SQUEEZE" ? color.yellow :
                  color.gray
    regimeLabel := label.new(bar_index, high + 2 * atr_conf, 
                             regime + " | " + volRegime,
                             color=regimeColor, 
                             textcolor=color.white,
                             style=label.style_label_down,
                             size=size.small)

// Confidence meter
var label confLabel = na
if i_showConfMeter and barstate.islast
    label.delete(confLabel)
    confColor = finalConfidence >= i_confStrong ? color.green :
                finalConfidence >= i_confSmall ? color.lime :
                finalConfidence > i_confWatch ? color.yellow :
                finalConfidence > i_confNoTrade ? color.orange :
                color.red
    confLabel := label.new(bar_index + 5, high + 2 * atr_conf,
                           "CONF: " + str.tostring(math.round(finalConfidence)) + "%",
                           color=confColor,
                           textcolor=color.white,
                           style=label.style_label_left,
                           size=size.normal)

// No-trade zone shading
bgcolor(i_showNoTradeZone and finalConfidence <= i_confNoTrade ? color.new(color.gray, 90) : na)

// Entry markers
markerSize = i_entryMarkerSize == "tiny" ? size.tiny :
             i_entryMarkerSize == "small" ? size.small :
             i_entryMarkerSize == "large" ? size.large :
             size.normal

plotshape(longEntry and signalStrength != "NONE", 
          title="Long Entry", 
          location=location.belowbar, 
          color=color.green, 
          style=shape.triangleup, 
          size=markerSize,
          text="LONG")

plotshape(shortEntry and signalStrength != "NONE", 
          title="Short Entry", 
          location=location.abovebar, 
          color=color.red, 
          style=shape.triangledown, 
          size=markerSize,
          text="SHORT")

// EMA plots
plot(emaFast, "EMA Fast", color=color.new(color.blue, 50), linewidth=1)
plot(emaSlow, "EMA Slow", color=color.new(color.orange, 50), linewidth=1)
plot(emaTrend, "EMA Trend", color=color.new(color.purple, 50), linewidth=2)

// Bollinger Bands
plot(bbUpper, "BB Upper", color=color.new(color.gray, 70), linewidth=1)
plot(bbLower, "BB Lower", color=color.new(color.gray, 70), linewidth=1)
plot(bbBasis, "BB Basis", color=color.new(color.gray, 80), linewidth=1, style=plot.style_circles)

// Donchian Channel
plot(donchianHigh, "Donchian High", color=color.new(color.teal, 70), linewidth=1)
plot(donchianLow, "Donchian Low", color=color.new(color.teal, 70), linewidth=1)

// ============================================================================
// DEBUG PANEL
// ============================================================================

var table debugTable = table.new(position.top_right, 2, 12, bgcolor=color.new(color.black, 80))

if i_showDebug and barstate.islast
    table.cell(debugTable, 0, 0, "METRIC", text_color=color.white, text_size=size.small)
    table.cell(debugTable, 1, 0, "VALUE", text_color=color.white, text_size=size.small)
    
    table.cell(debugTable, 0, 1, "Regime", text_color=color.gray, text_size=size.tiny)
    table.cell(debugTable, 1, 1, regime, text_color=color.white, text_size=size.tiny)
    
    table.cell(debugTable, 0, 2, "ADX", text_color=color.gray, text_size=size.tiny)
    table.cell(debugTable, 1, 2, str.tostring(math.round(adx_conf, 1)), text_color=color.white, text_size=size.tiny)
    
    table.cell(debugTable, 0, 3, "ATR Ratio", text_color=color.gray, text_size=size.tiny)
    table.cell(debugTable, 1, 3, str.tostring(math.round(atrRatio, 2)), text_color=color.white, text_size=size.tiny)
    
    table.cell(debugTable, 0, 4, "RSI", text_color=color.gray, text_size=size.tiny)
    table.cell(debugTable, 1, 4, str.tostring(math.round(rsi_conf, 1)), text_color=color.white, text_size=size.tiny)
    
    table.cell(debugTable, 0, 5, "Squeeze", text_color=color.gray, text_size=size.tiny)
    table.cell(debugTable, 1, 5, squeezeOn ? "ON" : "OFF", text_color=squeezeOn ? color.yellow : color.green, text_size=size.tiny)
    
    table.cell(debugTable, 0, 6, "Trend Signal", text_color=color.gray, text_size=size.tiny)
    table.cell(debugTable, 1, 6, longTrendSignal ? "LONG" : shortTrendSignal ? "SHORT" : "NONE", text_color=color.white, text_size=size.tiny)
    
    table.cell(debugTable, 0, 7, "Reversion Signal", text_color=color.gray, text_size=size.tiny)
    table.cell(debugTable, 1, 7, longReversionSignal ? "LONG" : shortReversionSignal ? "SHORT" : "NONE", text_color=color.white, text_size=size.tiny)
    
    table.cell(debugTable, 0, 8, "Breakout Signal", text_color=color.gray, text_size=size.tiny)
    table.cell(debugTable, 1, 8, longBreakoutSignal ? "LONG" : shortBreakoutSignal ? "SHORT" : "NONE", text_color=color.white, text_size=size.tiny)
    
    table.cell(debugTable, 0, 9, "Confidence", text_color=color.gray, text_size=size.tiny)
    table.cell(debugTable, 1, 9, str.tostring(math.round(finalConfidence)) + "%", text_color=color.white, text_size=size.tiny)
    
    table.cell(debugTable, 0, 10, "Signal Strength", text_color=color.gray, text_size=size.tiny)
    table.cell(debugTable, 1, 10, signalStrength, text_color=color.white, text_size=size.tiny)
    
    table.cell(debugTable, 0, 11, "No Trade", text_color=color.gray, text_size=size.tiny)
    table.cell(debugTable, 1, 11, noTradeConditions ? "YES" : "NO", text_color=noTradeConditions ? color.red : color.green, text_size=size.tiny)

// ============================================================================
// ALERTS
// ============================================================================

alertcondition(longEntry and signalStrength == "STRONG", 
               title="Strong Long Entry", 
               message="QUANT-OMEGA: Strong LONG signal. Confidence: {{plot_0}}%")

alertcondition(shortEntry and signalStrength == "STRONG", 
               title="Strong Short Entry", 
               message="QUANT-OMEGA: Strong SHORT signal. Confidence: {{plot_0}}%")

alertcondition(longEntry and signalStrength == "NORMAL", 
               title="Normal Long Entry", 
               message="QUANT-OMEGA: Normal LONG signal. Confidence: {{plot_0}}%")

alertcondition(shortEntry and signalStrength == "NORMAL", 
               title="Normal Short Entry", 
               message="QUANT-OMEGA: Normal SHORT signal. Confidence: {{plot_0}}%")

alertcondition(longEntry and signalStrength == "SMALL", 
               title="Small Long Entry", 
               message="QUANT-OMEGA: Small LONG signal. Confidence: {{plot_0}}%")

alertcondition(shortEntry and signalStrength == "SMALL", 
               title="Small Short Entry", 
               message="QUANT-OMEGA: Small SHORT signal. Confidence: {{plot_0}}%")

// Plot confidence for alerts
plot(finalConfidence, "Confidence", display=display.none)
