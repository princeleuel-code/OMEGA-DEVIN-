// ============================================================================
// OMEGA ULTIMATE V3 - THE BEST INDICATOR THE WORLD HAS EVER SEEN
// ============================================================================
// Version: 3.0.0 ULTIMATE
// Author: OMEGA-DEVIN System
// 
// This indicator combines EVERYTHING:
// - Deep Charts methodology (Order Flow, Volume Profile, CVD, Absorption)
// - Trader Kane's $2.3M methodology (50% Rule, PO3, SMT Divergence)
// - ICT/SMC concepts (Order Blocks, Fair Value Gaps, Liquidity Sweeps)
// - Flux indicator concepts (Multi-TF dashboard, all-in-one display)
// - Market structure analysis (BOS, CHOCH, Swing Points)
// - Kill zone timing (London, NY, Asia sessions)
// - Failed breakout detection
// - Price discovery vs price acceptance
// - Absorption pattern recognition
//
// NON-REPAINTING - All signals confirmed on bar close
// ============================================================================

//@version=5
indicator("OMEGA ULTIMATE V3 - All-Seeing Eye", 
     shorttitle="OMEGA V3", 
     overlay=true,
     max_labels_count=500,
     max_lines_count=500,
     max_boxes_count=500)

// ============================================================================
// INPUTS - ORGANIZED BY CATEGORY
// ============================================================================

// === GENERAL SETTINGS ===
i_nonRepaint = input.bool(true, "Non-Repainting Mode", group="General", tooltip="When ON, all signals are confirmed on bar close")
i_showDashboard = input.bool(true, "Show Main Dashboard", group="General")
i_showMTFDashboard = input.bool(true, "Show Multi-TF Dashboard", group="General")
i_showNarrative = input.bool(true, "Show Market Narrative", group="General")
i_alertsOn = input.bool(true, "Enable Alerts", group="General")

// === VOLUME PROFILE ===
i_showVP = input.bool(true, "Show Volume Profile", group="Volume Profile")
i_vpLookback = input.int(50, "VP Lookback Bars", minval=10, maxval=200, group="Volume Profile")
i_vpRows = input.int(24, "VP Rows", minval=10, maxval=50, group="Volume Profile")
i_showVAH = input.bool(true, "Show Value Area High", group="Volume Profile")
i_showVAL = input.bool(true, "Show Value Area Low", group="Volume Profile")
i_showPOC = input.bool(true, "Show Point of Control", group="Volume Profile")
i_vpColor = input.color(color.new(color.blue, 70), "VP Color", group="Volume Profile")
i_pocColor = input.color(color.yellow, "POC Color", group="Volume Profile")
i_vahColor = input.color(color.red, "VAH Color", group="Volume Profile")
i_valColor = input.color(color.green, "VAL Color", group="Volume Profile")

// === CUMULATIVE VOLUME DELTA (CVD) ===
i_showCVD = input.bool(true, "Show CVD Divergence", group="CVD")
i_cvdLength = input.int(14, "CVD Length", minval=5, maxval=50, group="CVD")
i_cvdDivThreshold = input.float(0.5, "CVD Divergence Threshold", minval=0.1, maxval=2.0, step=0.1, group="CVD")

// === ABSORPTION DETECTION ===
i_showAbsorption = input.bool(true, "Show Absorption Patterns", group="Absorption")
i_absVolMultiplier = input.float(1.5, "Absorption Volume Multiplier", minval=1.0, maxval=3.0, step=0.1, group="Absorption")
i_absWickRatio = input.float(0.6, "Absorption Wick Ratio", minval=0.3, maxval=0.9, step=0.1, group="Absorption")

// === FAILED BREAKOUT ===
i_showFailedBO = input.bool(true, "Show Failed Breakouts", group="Failed Breakout")
i_fboLookback = input.int(20, "Failed BO Lookback", minval=5, maxval=50, group="Failed Breakout")
i_fboConfirmBars = input.int(2, "Failed BO Confirm Bars", minval=1, maxval=5, group="Failed Breakout")

// === MARKET STRUCTURE ===
i_swingLength = input.int(5, "Swing Detection Length", minval=2, maxval=20, group="Market Structure")
i_showSwings = input.bool(true, "Show Swing Points", group="Market Structure")
i_showBOS = input.bool(true, "Show BOS/CHOCH", group="Market Structure")
i_showStructureLabels = input.bool(true, "Show Structure Labels", group="Market Structure")

// === ORDER BLOCKS ===
i_showOB = input.bool(true, "Show Order Blocks", group="Order Blocks")
i_obLookback = input.int(50, "OB Lookback", minval=10, maxval=200, group="Order Blocks")
i_obMitigation = input.bool(true, "Show Mitigated OBs", group="Order Blocks")
i_obBullColor = input.color(color.new(color.green, 80), "Bullish OB Color", group="Order Blocks")
i_obBearColor = input.color(color.new(color.red, 80), "Bearish OB Color", group="Order Blocks")

// === FAIR VALUE GAPS ===
i_showFVG = input.bool(true, "Show Fair Value Gaps", group="Fair Value Gaps")
i_fvgLookback = input.int(50, "FVG Lookback", minval=10, maxval=200, group="Fair Value Gaps")
i_fvgMinSize = input.float(0.1, "Min FVG Size %", minval=0.01, maxval=1.0, step=0.01, group="Fair Value Gaps")
i_fvgBullColor = input.color(color.new(color.teal, 80), "Bullish FVG Color", group="Fair Value Gaps")
i_fvgBearColor = input.color(color.new(color.maroon, 80), "Bearish FVG Color", group="Fair Value Gaps")

// === LIQUIDITY ===
i_showLiquidity = input.bool(true, "Show Liquidity Levels", group="Liquidity")
i_liqLookback = input.int(20, "Liquidity Lookback", minval=5, maxval=100, group="Liquidity")
i_showLiqSweep = input.bool(true, "Show Liquidity Sweeps", group="Liquidity")
i_liqColor = input.color(color.new(color.orange, 50), "Liquidity Color", group="Liquidity")

// === 50% EQUILIBRIUM (TRADER KANE) ===
i_show50Pct = input.bool(true, "Show 50% Equilibrium", group="50% Rule")
i_eqLookback = input.int(20, "Equilibrium Lookback", minval=5, maxval=100, group="50% Rule")
i_eqColor = input.color(color.new(color.purple, 50), "Equilibrium Color", group="50% Rule")

// === PO3 (POWER OF THREE) ===
i_showPO3 = input.bool(true, "Show PO3 Phases", group="PO3")
i_po3SessionStart = input.int(0, "Session Start Hour (UTC)", minval=0, maxval=23, group="PO3")
i_po3AccumHours = input.int(4, "Accumulation Hours", minval=1, maxval=8, group="PO3")
i_po3ManipHours = input.int(2, "Manipulation Hours", minval=1, maxval=4, group="PO3")

// === SMT DIVERGENCE ===
i_showSMT = input.bool(true, "Show SMT Divergence", group="SMT Divergence")
i_smtSymbol = input.symbol("ES1!", "Correlated Symbol", group="SMT Divergence")
i_smtLookback = input.int(10, "SMT Lookback", minval=3, maxval=30, group="SMT Divergence")

// === KILL ZONES ===
i_showKillZones = input.bool(true, "Show Kill Zones", group="Kill Zones")
i_londonStart = input.int(8, "London Start (UTC)", minval=0, maxval=23, group="Kill Zones")
i_londonEnd = input.int(11, "London End (UTC)", minval=0, maxval=23, group="Kill Zones")
i_nyStart = input.int(13, "NY Start (UTC)", minval=0, maxval=23, group="Kill Zones")
i_nyEnd = input.int(16, "NY End (UTC)", minval=0, maxval=23, group="Kill Zones")
i_asiaStart = input.int(0, "Asia Start (UTC)", minval=0, maxval=23, group="Kill Zones")
i_asiaEnd = input.int(3, "Asia End (UTC)", minval=0, maxval=23, group="Kill Zones")

// === MULTI-TIMEFRAME ===
i_useMTF = input.bool(true, "Use Multi-Timeframe Analysis", group="Multi-Timeframe")
i_mtf1 = input.timeframe("1", "MTF 1 (1m)", group="Multi-Timeframe")
i_mtf2 = input.timeframe("5", "MTF 2 (5m)", group="Multi-Timeframe")
i_mtf3 = input.timeframe("15", "MTF 3 (15m)", group="Multi-Timeframe")
i_mtf4 = input.timeframe("60", "MTF 4 (1H)", group="Multi-Timeframe")
i_mtf5 = input.timeframe("240", "MTF 5 (4H)", group="Multi-Timeframe")
i_mtf6 = input.timeframe("D", "MTF 6 (Daily)", group="Multi-Timeframe")
i_mtf7 = input.timeframe("W", "MTF 7 (Weekly)", group="Multi-Timeframe")
i_mtf8 = input.timeframe("M", "MTF 8 (Monthly)", group="Multi-Timeframe")

// === REGIME DETECTION ===
i_adxPeriod = input.int(14, "ADX Period", minval=5, maxval=50, group="Regime")
i_adxThreshold = input.int(25, "ADX Trend Threshold", minval=15, maxval=40, group="Regime")
i_atrPeriod = input.int(14, "ATR Period", minval=5, maxval=50, group="Regime")

// === CONFLUENCE SCORING ===
i_confThreshold = input.int(70, "Confluence Threshold", minval=50, maxval=100, group="Confluence")
i_showConfluence = input.bool(true, "Show Confluence Score", group="Confluence")

// === VISUAL SETTINGS ===
i_bullColor = input.color(color.green, "Bullish Color", group="Visual")
i_bearColor = input.color(color.red, "Bearish Color", group="Visual")
i_neutralColor = input.color(color.gray, "Neutral Color", group="Visual")

// ============================================================================
// HELPER FUNCTIONS
// ============================================================================

// Non-repainting confirmation
confirmed(src) => i_nonRepaint ? src[1] : src

// True Range
tr_() => math.max(high - low, math.abs(high - close[1]), math.abs(low - close[1]))

// ATR
atr_(length) => ta.rma(tr_(), length)

// ADX
adx_(length) =>
    up = ta.change(high)
    down = -ta.change(low)
    plusDM = na(up) ? na : (up > down and up > 0 ? up : 0)
    minusDM = na(down) ? na : (down > up and down > 0 ? down : 0)
    trueRange = tr_()
    plusDI = 100 * ta.rma(plusDM, length) / ta.rma(trueRange, length)
    minusDI = 100 * ta.rma(minusDM, length) / ta.rma(trueRange, length)
    dx = 100 * math.abs(plusDI - minusDI) / (plusDI + minusDI)
    adxVal = ta.rma(dx, length)
    [adxVal, plusDI, minusDI]

// RSI
rsi_(src, length) => ta.rsi(src, length)

// ============================================================================
// VOLUME PROFILE CALCULATION
// ============================================================================

// Calculate volume profile
var float[] vpVolumes = array.new_float(i_vpRows, 0.0)
var float vpHigh = na
var float vpLow = na
var float vpPOC = na
var float vpVAH = na
var float vpVAL = na

if barstate.islast
    // Reset arrays
    for i = 0 to i_vpRows - 1
        array.set(vpVolumes, i, 0.0)
    
    // Calculate range
    vpHigh := ta.highest(high, i_vpLookback)
    vpLow := ta.lowest(low, i_vpLookback)
    rowHeight = (vpHigh - vpLow) / i_vpRows
    
    // Distribute volume to rows
    for j = 0 to i_vpLookback - 1
        if not na(volume[j])
            // Find which row this bar belongs to
            midPrice = (high[j] + low[j]) / 2
            rowIndex = math.floor((midPrice - vpLow) / rowHeight)
            rowIndex := math.max(0, math.min(i_vpRows - 1, rowIndex))
            array.set(vpVolumes, rowIndex, array.get(vpVolumes, rowIndex) + volume[j])
    
    // Find POC (highest volume row)
    maxVol = 0.0
    pocIndex = 0
    for i = 0 to i_vpRows - 1
        if array.get(vpVolumes, i) > maxVol
            maxVol := array.get(vpVolumes, i)
            pocIndex := i
    
    vpPOC := vpLow + (pocIndex + 0.5) * rowHeight
    
    // Calculate Value Area (70% of volume)
    totalVol = array.sum(vpVolumes)
    targetVol = totalVol * 0.7
    
    // Expand from POC
    vaLowIndex = pocIndex
    vaHighIndex = pocIndex
    vaVol = array.get(vpVolumes, pocIndex)
    
    while vaVol < targetVol and (vaLowIndex > 0 or vaHighIndex < i_vpRows - 1)
        lowVol = vaLowIndex > 0 ? array.get(vpVolumes, vaLowIndex - 1) : 0.0
        highVol = vaHighIndex < i_vpRows - 1 ? array.get(vpVolumes, vaHighIndex + 1) : 0.0
        
        if lowVol > highVol and vaLowIndex > 0
            vaLowIndex -= 1
            vaVol += lowVol
        else if vaHighIndex < i_vpRows - 1
            vaHighIndex += 1
            vaVol += highVol
        else if vaLowIndex > 0
            vaLowIndex -= 1
            vaVol += lowVol
        else
            break
    
    vpVAL := vpLow + vaLowIndex * rowHeight
    vpVAH := vpLow + (vaHighIndex + 1) * rowHeight

// Draw Volume Profile lines
var line pocLine = na
var line vahLine = na
var line valLine = na

if i_showVP and barstate.islast
    line.delete(pocLine)
    line.delete(vahLine)
    line.delete(valLine)
    
    if i_showPOC and not na(vpPOC)
        pocLine := line.new(bar_index - i_vpLookback, vpPOC, bar_index, vpPOC, 
                           color=i_pocColor, style=line.style_solid, width=2)
    
    if i_showVAH and not na(vpVAH)
        vahLine := line.new(bar_index - i_vpLookback, vpVAH, bar_index, vpVAH, 
                           color=i_vahColor, style=line.style_dashed, width=1)
    
    if i_showVAL and not na(vpVAL)
        valLine := line.new(bar_index - i_vpLookback, vpVAL, bar_index, vpVAL, 
                           color=i_valColor, style=line.style_dashed, width=1)

// ============================================================================
// CUMULATIVE VOLUME DELTA (CVD)
// ============================================================================

// Estimate buying/selling pressure from candle
buyVol = volume * (close - low) / (high - low)
sellVol = volume * (high - close) / (high - low)
delta = buyVol - sellVol

// Cumulative delta
cvd = ta.cum(delta)
cvdSMA = ta.sma(cvd, i_cvdLength)

// CVD Divergence Detection
// Bullish divergence: Price making lower lows, CVD making higher lows
// Bearish divergence: Price making higher highs, CVD making lower highs

priceLow = ta.lowest(low, i_cvdLength)
priceHigh = ta.highest(high, i_cvdLength)
cvdLow = ta.lowest(cvd, i_cvdLength)
cvdHigh = ta.highest(cvd, i_cvdLength)

// Check for divergence
bullCVDDiv = low <= priceLow[1] and cvd > cvdLow[1] * (1 + i_cvdDivThreshold)
bearCVDDiv = high >= priceHigh[1] and cvd < cvdHigh[1] * (1 - i_cvdDivThreshold)

// Plot CVD divergence
plotshape(i_showCVD and bullCVDDiv, title="Bull CVD Div", location=location.belowbar, 
          color=color.lime, style=shape.triangleup, size=size.small, text="CVD+")
plotshape(i_showCVD and bearCVDDiv, title="Bear CVD Div", location=location.abovebar, 
          color=color.fuchsia, style=shape.triangledown, size=size.small, text="CVD-")

// ============================================================================
// ABSORPTION DETECTION
// ============================================================================

// Absorption: High volume with rejection (long wick)
atr = atr_(i_atrPeriod)
volSMA = ta.sma(volume, 20)
highVolume = volume > volSMA * i_absVolMultiplier

// Calculate wick ratios
bodySize = math.abs(close - open)
totalRange = high - low
upperWick = high - math.max(close, open)
lowerWick = math.min(close, open) - low

// Bullish absorption: High volume, long lower wick, price closes up
bullAbsorption = highVolume and 
                 lowerWick > totalRange * i_absWickRatio and 
                 close > open

// Bearish absorption: High volume, long upper wick, price closes down
bearAbsorption = highVolume and 
                 upperWick > totalRange * i_absWickRatio and 
                 close < open

// Plot absorption
plotshape(i_showAbsorption and bullAbsorption, title="Bull Absorption", 
          location=location.belowbar, color=color.aqua, style=shape.diamond, 
          size=size.small, text="ABS")
plotshape(i_showAbsorption and bearAbsorption, title="Bear Absorption", 
          location=location.abovebar, color=color.orange, style=shape.diamond, 
          size=size.small, text="ABS")

// ============================================================================
// FAILED BREAKOUT DETECTION
// ============================================================================

// Track recent highs/lows
recentHigh = ta.highest(high, i_fboLookback)
recentLow = ta.lowest(low, i_fboLookback)

// Failed breakout above: Price breaks above recent high then closes back below
var bool fboAboveSetup = false
var float fboAboveLevel = na

if high > recentHigh[1] and close < recentHigh[1]
    fboAboveSetup := true
    fboAboveLevel := recentHigh[1]

// Confirm failed breakout after X bars
failedBOAbove = fboAboveSetup and close < fboAboveLevel
if failedBOAbove
    fboAboveSetup := false

// Failed breakout below: Price breaks below recent low then closes back above
var bool fboBelowSetup = false
var float fboBelowLevel = na

if low < recentLow[1] and close > recentLow[1]
    fboBelowSetup := true
    fboBelowLevel := recentLow[1]

// Confirm failed breakout
failedBOBelow = fboBelowSetup and close > fboBelowLevel
if failedBOBelow
    fboBelowSetup := false

// Plot failed breakouts
plotshape(i_showFailedBO and failedBOAbove, title="Failed BO Above", 
          location=location.abovebar, color=color.red, style=shape.xcross, 
          size=size.normal, text="FBO")
plotshape(i_showFailedBO and failedBOBelow, title="Failed BO Below", 
          location=location.belowbar, color=color.green, style=shape.xcross, 
          size=size.normal, text="FBO")

// ============================================================================
// MARKET STRUCTURE DETECTION
// ============================================================================

// Swing High/Low Detection
pivotHigh = ta.pivothigh(high, i_swingLength, i_swingLength)
pivotLow = ta.pivotlow(low, i_swingLength, i_swingLength)

// Track swing points
var float lastSwingHigh = na
var float lastSwingLow = na
var int lastSwingHighBar = na
var int lastSwingLowBar = na
var float prevSwingHigh = na
var float prevSwingLow = na

if not na(pivotHigh)
    prevSwingHigh := lastSwingHigh
    lastSwingHigh := pivotHigh
    lastSwingHighBar := bar_index - i_swingLength

if not na(pivotLow)
    prevSwingLow := lastSwingLow
    lastSwingLow := pivotLow
    lastSwingLowBar := bar_index - i_swingLength

// Market Structure Classification
var string marketStructure = "NEUTRAL"
var string lastBOS = "NONE"

// Higher High / Higher Low / Lower High / Lower Low
isHH = not na(pivotHigh) and pivotHigh > prevSwingHigh
isHL = not na(pivotLow) and pivotLow > prevSwingLow
isLH = not na(pivotHigh) and pivotHigh < prevSwingHigh
isLL = not na(pivotLow) and pivotLow < prevSwingLow

// Break of Structure (BOS) - Continuation
bullishBOS = close > lastSwingHigh and close[1] <= lastSwingHigh
bearishBOS = close < lastSwingLow and close[1] >= lastSwingLow

// Change of Character (CHOCH) - Reversal
bullishCHOCH = marketStructure == "BEARISH" and close > lastSwingHigh
bearishCHOCH = marketStructure == "BULLISH" and close < lastSwingLow

// Update market structure
if isHH and isHL
    marketStructure := "BULLISH"
if isLH and isLL
    marketStructure := "BEARISH"

// Track BOS/CHOCH
if bullishBOS
    lastBOS := "BULL_BOS"
if bearishBOS
    lastBOS := "BEAR_BOS"
if bullishCHOCH
    lastBOS := "BULL_CHOCH"
if bearishCHOCH
    lastBOS := "BEAR_CHOCH"

// Plot swing points
plotshape(i_showSwings and not na(pivotHigh), title="Swing High", location=location.abovebar, 
          color=i_bearColor, style=shape.triangledown, size=size.tiny, offset=-i_swingLength)
plotshape(i_showSwings and not na(pivotLow), title="Swing Low", location=location.belowbar, 
          color=i_bullColor, style=shape.triangleup, size=size.tiny, offset=-i_swingLength)

// Plot BOS/CHOCH labels
if i_showBOS and bullishBOS
    label.new(bar_index, low, "BOS", color=i_bullColor, textcolor=color.white, 
              style=label.style_label_up, size=size.tiny)
if i_showBOS and bearishBOS
    label.new(bar_index, high, "BOS", color=i_bearColor, textcolor=color.white, 
              style=label.style_label_down, size=size.tiny)
if i_showBOS and bullishCHOCH
    label.new(bar_index, low, "CHOCH", color=color.lime, textcolor=color.white, 
              style=label.style_label_up, size=size.small)
if i_showBOS and bearishCHOCH
    label.new(bar_index, high, "CHOCH", color=color.fuchsia, textcolor=color.white, 
              style=label.style_label_down, size=size.small)

// ============================================================================
// ORDER BLOCK DETECTION
// ============================================================================

var box[] bullOBs = array.new_box()
var box[] bearOBs = array.new_box()

// Detect bullish OB
bullishOB = close[2] < open[2] and close[1] > open[1] and close > high[2] and (close - open[1]) > 1.5 * atr

// Detect bearish OB
bearishOB = close[2] > open[2] and close[1] < open[1] and close < low[2] and (open[1] - close) > 1.5 * atr

// Draw Order Blocks
if i_showOB and bullishOB
    obBox = box.new(bar_index - 2, high[2], bar_index + 20, low[2], 
                    bgcolor=i_obBullColor, border_color=color.green, border_width=1)
    array.push(bullOBs, obBox)
    if array.size(bullOBs) > 10
        box.delete(array.shift(bullOBs))

if i_showOB and bearishOB
    obBox = box.new(bar_index - 2, high[2], bar_index + 20, low[2], 
                    bgcolor=i_obBearColor, border_color=color.red, border_width=1)
    array.push(bearOBs, obBox)
    if array.size(bearOBs) > 10
        box.delete(array.shift(bearOBs))

// ============================================================================
// FAIR VALUE GAP DETECTION
// ============================================================================

var box[] bullFVGs = array.new_box()
var box[] bearFVGs = array.new_box()

fvgBullGap = low - high[2]
bullishFVG = fvgBullGap > 0 and fvgBullGap / close * 100 > i_fvgMinSize

fvgBearGap = low[2] - high
bearishFVG = fvgBearGap > 0 and fvgBearGap / close * 100 > i_fvgMinSize

if i_showFVG and bullishFVG
    fvgBox = box.new(bar_index - 1, low, bar_index + 20, high[2], 
                     bgcolor=i_fvgBullColor, border_color=color.teal, border_width=1)
    array.push(bullFVGs, fvgBox)
    if array.size(bullFVGs) > 10
        box.delete(array.shift(bullFVGs))

if i_showFVG and bearishFVG
    fvgBox = box.new(bar_index - 1, low[2], bar_index + 20, high, 
                     bgcolor=i_fvgBearColor, border_color=color.maroon, border_width=1)
    array.push(bearFVGs, fvgBox)
    if array.size(bearFVGs) > 10
        box.delete(array.shift(bearFVGs))

// ============================================================================
// LIQUIDITY DETECTION
// ============================================================================

highestHigh = ta.highest(high, i_liqLookback)
lowestLow = ta.lowest(low, i_liqLookback)

bullLiqSweep = high > highestHigh[1] and close < highestHigh[1]
bearLiqSweep = low < lowestLow[1] and close > lowestLow[1]

plotshape(i_showLiqSweep and bullLiqSweep, title="Bull Liq Sweep", 
          location=location.abovebar, color=color.orange, style=shape.diamond, size=size.small)
plotshape(i_showLiqSweep and bearLiqSweep, title="Bear Liq Sweep", 
          location=location.belowbar, color=color.orange, style=shape.diamond, size=size.small)

var line liqHighLine = na
var line liqLowLine = na

if i_showLiquidity and barstate.islast
    line.delete(liqHighLine)
    line.delete(liqLowLine)
    liqHighLine := line.new(bar_index - i_liqLookback, highestHigh, bar_index, highestHigh, 
                            color=i_liqColor, style=line.style_dashed, width=2)
    liqLowLine := line.new(bar_index - i_liqLookback, lowestLow, bar_index, lowestLow, 
                           color=i_liqColor, style=line.style_dashed, width=2)

// ============================================================================
// 50% EQUILIBRIUM (TRADER KANE'S RULE)
// ============================================================================

rangeHigh = ta.highest(high, i_eqLookback)
rangeLow = ta.lowest(low, i_eqLookback)
equilibrium = (rangeHigh + rangeLow) / 2

premiumZone = close > equilibrium
discountZone = close < equilibrium

plot(i_show50Pct ? equilibrium : na, "50% Equilibrium", color=i_eqColor, linewidth=2, style=plot.style_circles)
bgcolor(i_show50Pct and premiumZone ? color.new(color.red, 95) : na, title="Premium Zone")
bgcolor(i_show50Pct and discountZone ? color.new(color.green, 95) : na, title="Discount Zone")

// ============================================================================
// PO3 - POWER OF THREE
// ============================================================================

currentHour = hour(time, "UTC")
sessionHour = (currentHour - i_po3SessionStart + 24) % 24

isAccumulation = sessionHour < i_po3AccumHours
isManipulation = sessionHour >= i_po3AccumHours and sessionHour < (i_po3AccumHours + i_po3ManipHours)
isDistribution = sessionHour >= (i_po3AccumHours + i_po3ManipHours)

po3Phase = isAccumulation ? "ACCUMULATION" : isManipulation ? "MANIPULATION" : "DISTRIBUTION"

po3Color = isAccumulation ? color.new(color.blue, 90) : 
           isManipulation ? color.new(color.orange, 90) : 
           color.new(color.purple, 90)

bgcolor(i_showPO3 ? po3Color : na, title="PO3 Phase")

// ============================================================================
// SMT DIVERGENCE
// ============================================================================

[smtOpen, smtHigh, smtLow, smtClose] = request.security(i_smtSymbol, timeframe.period, 
    [open, high, low, close], lookahead=barmerge.lookahead_off)

currentLL = low < ta.lowest(low, i_smtLookback)[1]
currentHH = high > ta.highest(high, i_smtLookback)[1]

smtHL = smtLow > ta.lowest(smtLow, i_smtLookback)[1]
smtLH = smtHigh < ta.highest(smtHigh, i_smtLookback)[1]

bullishSMT = currentLL and smtHL
bearishSMT = currentHH and smtLH

plotshape(i_showSMT and bullishSMT, title="Bullish SMT", location=location.belowbar, 
          color=color.lime, style=shape.circle, size=size.small, text="SMT")
plotshape(i_showSMT and bearishSMT, title="Bearish SMT", location=location.abovebar, 
          color=color.fuchsia, style=shape.circle, size=size.small, text="SMT")

// ============================================================================
// KILL ZONES
// ============================================================================

inLondonKZ = currentHour >= i_londonStart and currentHour < i_londonEnd
inNYKZ = currentHour >= i_nyStart and currentHour < i_nyEnd
inAsiaKZ = currentHour >= i_asiaStart and currentHour < i_asiaEnd
inKillZone = inLondonKZ or inNYKZ or inAsiaKZ

killZoneColor = inLondonKZ ? color.new(color.blue, 95) : 
                inNYKZ ? color.new(color.green, 95) : 
                inAsiaKZ ? color.new(color.yellow, 95) : na

bgcolor(i_showKillZones ? killZoneColor : na, title="Kill Zone")

// ============================================================================
// MULTI-TIMEFRAME ANALYSIS
// ============================================================================

// Get trend from each timeframe
getTrend(tf) =>
    [tfClose, tfEMA] = request.security(syminfo.tickerid, tf, [close, ta.ema(close, 21)], lookahead=barmerge.lookahead_off)
    tfClose > tfEMA ? 1 : -1

mtf1_trend = getTrend(i_mtf1)
mtf2_trend = getTrend(i_mtf2)
mtf3_trend = getTrend(i_mtf3)
mtf4_trend = getTrend(i_mtf4)
mtf5_trend = getTrend(i_mtf5)
mtf6_trend = getTrend(i_mtf6)
mtf7_trend = getTrend(i_mtf7)
mtf8_trend = getTrend(i_mtf8)

// Count aligned timeframes
bullishTFs = (mtf1_trend > 0 ? 1 : 0) + (mtf2_trend > 0 ? 1 : 0) + (mtf3_trend > 0 ? 1 : 0) + 
             (mtf4_trend > 0 ? 1 : 0) + (mtf5_trend > 0 ? 1 : 0) + (mtf6_trend > 0 ? 1 : 0) +
             (mtf7_trend > 0 ? 1 : 0) + (mtf8_trend > 0 ? 1 : 0)
bearishTFs = 8 - bullishTFs

mtfAligned = bullishTFs >= 6 or bearishTFs >= 6
mtfBullish = bullishTFs >= 6
mtfBearish = bearishTFs >= 6

// ============================================================================
// REGIME DETECTION
// ============================================================================

[adx, diPlus, diMinus] = adx_(i_adxPeriod)
atrSlow = atr_(50)
atrRatio = atr / atrSlow

regime = adx > i_adxThreshold ? "TRENDING" : 
         atrRatio > 1.2 ? "VOLATILE" : 
         atrRatio < 0.8 ? "QUIET" : "RANGING"

trendDir = diPlus > diMinus ? 1 : -1

// ============================================================================
// CONFLUENCE SCORING (0-100)
// ============================================================================

calcConfluence() =>
    score = 0.0
    
    // Market Structure (0-15)
    if marketStructure == "BULLISH" or marketStructure == "BEARISH"
        score += 15
    else
        score += 5
    
    // MTF Alignment (0-20)
    if mtfAligned
        score += 20
    else
        score += math.max(bullishTFs, bearishTFs) * 2
    
    // Kill Zone (0-10)
    if inKillZone
        score += 10
    
    // Discount/Premium Zone (0-15)
    if (marketStructure == "BULLISH" and discountZone) or (marketStructure == "BEARISH" and premiumZone)
        score += 15
    else if (marketStructure == "BULLISH" and premiumZone) or (marketStructure == "BEARISH" and discountZone)
        score += 0
    else
        score += 7
    
    // Recent BOS/CHOCH (0-10)
    if lastBOS == "BULL_CHOCH" or lastBOS == "BEAR_CHOCH"
        score += 10
    else if lastBOS == "BULL_BOS" or lastBOS == "BEAR_BOS"
        score += 7
    
    // SMT Divergence (0-10)
    if bullishSMT or bearishSMT
        score += 10
    
    // CVD Divergence (0-10)
    if bullCVDDiv or bearCVDDiv
        score += 10
    
    // Absorption (0-5)
    if bullAbsorption or bearAbsorption
        score += 5
    
    // Failed Breakout (0-5)
    if failedBOAbove or failedBOBelow
        score += 5
    
    math.min(100, score)

confluence = calcConfluence()

// ============================================================================
// SIGNAL GENERATION
// ============================================================================

// Ultimate Long Signal
ultimateLong = marketStructure == "BULLISH" and
               mtfBullish and
               discountZone and
               inKillZone and
               confluence >= i_confThreshold and
               (bullishBOS or bullishCHOCH or bearLiqSweep or bullishSMT or bullCVDDiv or bullAbsorption or failedBOBelow)

// Ultimate Short Signal
ultimateShort = marketStructure == "BEARISH" and
                mtfBearish and
                premiumZone and
                inKillZone and
                confluence >= i_confThreshold and
                (bearishBOS or bearishCHOCH or bullLiqSweep or bearishSMT or bearCVDDiv or bearAbsorption or failedBOAbove)

// Confirmed signals
longSignal = confirmed(ultimateLong) and not confirmed(ultimateLong)[1]
shortSignal = confirmed(ultimateShort) and not confirmed(ultimateShort)[1]

// Plot signals
plotshape(longSignal, title="ULTIMATE LONG", location=location.belowbar, 
          color=color.lime, style=shape.labelup, size=size.large, text="LONG")
plotshape(shortSignal, title="ULTIMATE SHORT", location=location.abovebar, 
          color=color.red, style=shape.labeldown, size=size.large, text="SHORT")

// ============================================================================
// MAIN DASHBOARD
// ============================================================================

var table dashboard = table.new(position.top_right, 2, 20, bgcolor=color.new(color.black, 85), 
                                border_width=1, border_color=color.gray)

if i_showDashboard and barstate.islast
    // Header
    table.cell(dashboard, 0, 0, "OMEGA V3", text_color=color.gold, text_size=size.normal, bgcolor=color.new(color.purple, 70))
    table.cell(dashboard, 1, 0, "ALL-SEEING", text_color=color.white, text_size=size.small, bgcolor=color.new(color.purple, 70))
    
    // Market Structure
    structColor = marketStructure == "BULLISH" ? color.green : marketStructure == "BEARISH" ? color.red : color.gray
    table.cell(dashboard, 0, 1, "Structure", text_color=color.gray, text_size=size.tiny)
    table.cell(dashboard, 1, 1, marketStructure, text_color=structColor, text_size=size.tiny)
    
    // Regime
    regimeColor = regime == "TRENDING" ? color.green : regime == "VOLATILE" ? color.orange : color.gray
    table.cell(dashboard, 0, 2, "Regime", text_color=color.gray, text_size=size.tiny)
    table.cell(dashboard, 1, 2, regime, text_color=regimeColor, text_size=size.tiny)
    
    // MTF Alignment
    mtfText = str.tostring(bullishTFs) + "/8 Bull"
    mtfColor = mtfBullish ? color.green : mtfBearish ? color.red : color.yellow
    table.cell(dashboard, 0, 3, "MTF Align", text_color=color.gray, text_size=size.tiny)
    table.cell(dashboard, 1, 3, mtfText, text_color=mtfColor, text_size=size.tiny)
    
    // Zone
    zoneText = premiumZone ? "PREMIUM" : "DISCOUNT"
    zoneColor = premiumZone ? color.red : color.green
    table.cell(dashboard, 0, 4, "Zone", text_color=color.gray, text_size=size.tiny)
    table.cell(dashboard, 1, 4, zoneText, text_color=zoneColor, text_size=size.tiny)
    
    // PO3 Phase
    po3TextColor = isAccumulation ? color.blue : isManipulation ? color.orange : color.purple
    table.cell(dashboard, 0, 5, "PO3", text_color=color.gray, text_size=size.tiny)
    table.cell(dashboard, 1, 5, po3Phase, text_color=po3TextColor, text_size=size.tiny)
    
    // Kill Zone
    kzText = inLondonKZ ? "LONDON" : inNYKZ ? "NEW YORK" : inAsiaKZ ? "ASIA" : "NONE"
    kzColor = inKillZone ? color.green : color.gray
    table.cell(dashboard, 0, 6, "Kill Zone", text_color=color.gray, text_size=size.tiny)
    table.cell(dashboard, 1, 6, kzText, text_color=kzColor, text_size=size.tiny)
    
    // Last BOS
    bosColor = str.contains(lastBOS, "BULL") ? color.green : str.contains(lastBOS, "BEAR") ? color.red : color.gray
    table.cell(dashboard, 0, 7, "Last BOS", text_color=color.gray, text_size=size.tiny)
    table.cell(dashboard, 1, 7, lastBOS, text_color=bosColor, text_size=size.tiny)
    
    // Volume Profile
    table.cell(dashboard, 0, 8, "--- VP ---", text_color=color.yellow, text_size=size.tiny)
    table.cell(dashboard, 1, 8, "", text_color=color.yellow, text_size=size.tiny)
    
    // POC
    table.cell(dashboard, 0, 9, "POC", text_color=color.gray, text_size=size.tiny)
    table.cell(dashboard, 1, 9, str.tostring(math.round(vpPOC * 100) / 100), text_color=i_pocColor, text_size=size.tiny)
    
    // VAH
    table.cell(dashboard, 0, 10, "VAH", text_color=color.gray, text_size=size.tiny)
    table.cell(dashboard, 1, 10, str.tostring(math.round(vpVAH * 100) / 100), text_color=i_vahColor, text_size=size.tiny)
    
    // VAL
    table.cell(dashboard, 0, 11, "VAL", text_color=color.gray, text_size=size.tiny)
    table.cell(dashboard, 1, 11, str.tostring(math.round(vpVAL * 100) / 100), text_color=i_valColor, text_size=size.tiny)
    
    // Signals
    table.cell(dashboard, 0, 12, "--- SIGNALS ---", text_color=color.aqua, text_size=size.tiny)
    table.cell(dashboard, 1, 12, "", text_color=color.aqua, text_size=size.tiny)
    
    // CVD Div
    cvdText = bullCVDDiv ? "BULLISH" : bearCVDDiv ? "BEARISH" : "NONE"
    cvdColor = bullCVDDiv ? color.lime : bearCVDDiv ? color.fuchsia : color.gray
    table.cell(dashboard, 0, 13, "CVD Div", text_color=color.gray, text_size=size.tiny)
    table.cell(dashboard, 1, 13, cvdText, text_color=cvdColor, text_size=size.tiny)
    
    // Absorption
    absText = bullAbsorption ? "BULL ABS" : bearAbsorption ? "BEAR ABS" : "NONE"
    absColor = bullAbsorption ? color.aqua : bearAbsorption ? color.orange : color.gray
    table.cell(dashboard, 0, 14, "Absorption", text_color=color.gray, text_size=size.tiny)
    table.cell(dashboard, 1, 14, absText, text_color=absColor, text_size=size.tiny)
    
    // Failed BO
    fboText = failedBOAbove ? "ABOVE" : failedBOBelow ? "BELOW" : "NONE"
    fboColor = failedBOAbove ? color.red : failedBOBelow ? color.green : color.gray
    table.cell(dashboard, 0, 15, "Failed BO", text_color=color.gray, text_size=size.tiny)
    table.cell(dashboard, 1, 15, fboText, text_color=fboColor, text_size=size.tiny)
    
    // SMT
    smtText = bullishSMT ? "BULLISH" : bearishSMT ? "BEARISH" : "NONE"
    smtColor = bullishSMT ? color.lime : bearishSMT ? color.fuchsia : color.gray
    table.cell(dashboard, 0, 16, "SMT Div", text_color=color.gray, text_size=size.tiny)
    table.cell(dashboard, 1, 16, smtText, text_color=smtColor, text_size=size.tiny)
    
    // Confluence Score
    confColor = confluence >= 85 ? color.lime : confluence >= 70 ? color.green : confluence >= 50 ? color.yellow : color.red
    table.cell(dashboard, 0, 17, "Confluence", text_color=color.gray, text_size=size.tiny)
    table.cell(dashboard, 1, 17, str.tostring(math.round(confluence)) + "%", text_color=confColor, text_size=size.tiny)
    
    // Signal
    signalText = longSignal ? "LONG" : shortSignal ? "SHORT" : "WAIT"
    signalColor = longSignal ? color.lime : shortSignal ? color.red : color.gray
    table.cell(dashboard, 0, 18, "SIGNAL", text_color=color.white, text_size=size.small, bgcolor=color.new(signalColor, 50))
    table.cell(dashboard, 1, 18, signalText, text_color=color.white, text_size=size.small, bgcolor=color.new(signalColor, 50))

// ============================================================================
// MULTI-TIMEFRAME DASHBOARD
// ============================================================================

var table mtfTable = table.new(position.bottom_right, 9, 2, bgcolor=color.new(color.black, 85), 
                               border_width=1, border_color=color.gray)

if i_showMTFDashboard and barstate.islast
    // Headers
    table.cell(mtfTable, 0, 0, "TF", text_color=color.white, text_size=size.tiny)
    table.cell(mtfTable, 1, 0, i_mtf1, text_color=color.gray, text_size=size.tiny)
    table.cell(mtfTable, 2, 0, i_mtf2, text_color=color.gray, text_size=size.tiny)
    table.cell(mtfTable, 3, 0, i_mtf3, text_color=color.gray, text_size=size.tiny)
    table.cell(mtfTable, 4, 0, i_mtf4, text_color=color.gray, text_size=size.tiny)
    table.cell(mtfTable, 5, 0, i_mtf5, text_color=color.gray, text_size=size.tiny)
    table.cell(mtfTable, 6, 0, i_mtf6, text_color=color.gray, text_size=size.tiny)
    table.cell(mtfTable, 7, 0, i_mtf7, text_color=color.gray, text_size=size.tiny)
    table.cell(mtfTable, 8, 0, i_mtf8, text_color=color.gray, text_size=size.tiny)
    
    // Trend indicators
    table.cell(mtfTable, 0, 1, "Trend", text_color=color.white, text_size=size.tiny)
    table.cell(mtfTable, 1, 1, mtf1_trend > 0 ? "▲" : "▼", text_color=mtf1_trend > 0 ? color.green : color.red, text_size=size.small)
    table.cell(mtfTable, 2, 1, mtf2_trend > 0 ? "▲" : "▼", text_color=mtf2_trend > 0 ? color.green : color.red, text_size=size.small)
    table.cell(mtfTable, 3, 1, mtf3_trend > 0 ? "▲" : "▼", text_color=mtf3_trend > 0 ? color.green : color.red, text_size=size.small)
    table.cell(mtfTable, 4, 1, mtf4_trend > 0 ? "▲" : "▼", text_color=mtf4_trend > 0 ? color.green : color.red, text_size=size.small)
    table.cell(mtfTable, 5, 1, mtf5_trend > 0 ? "▲" : "▼", text_color=mtf5_trend > 0 ? color.green : color.red, text_size=size.small)
    table.cell(mtfTable, 6, 1, mtf6_trend > 0 ? "▲" : "▼", text_color=mtf6_trend > 0 ? color.green : color.red, text_size=size.small)
    table.cell(mtfTable, 7, 1, mtf7_trend > 0 ? "▲" : "▼", text_color=mtf7_trend > 0 ? color.green : color.red, text_size=size.small)
    table.cell(mtfTable, 8, 1, mtf8_trend > 0 ? "▲" : "▼", text_color=mtf8_trend > 0 ? color.green : color.red, text_size=size.small)

// ============================================================================
// MARKET NARRATIVE
// ============================================================================

var label narrativeLabel = na

if i_showNarrative and barstate.islast
    label.delete(narrativeLabel)
    
    narrative = ""
    
    // Structure narrative
    if marketStructure == "BULLISH"
        narrative := "BULLISH structure (HH/HL). "
    else if marketStructure == "BEARISH"
        narrative := "BEARISH structure (LH/LL). "
    else
        narrative := "NEUTRAL structure. "
    
    // MTF narrative
    narrative := narrative + str.tostring(bullishTFs) + "/8 TFs bullish. "
    
    // Zone narrative
    if premiumZone
        narrative := narrative + "PREMIUM zone. "
    else
        narrative := narrative + "DISCOUNT zone. "
    
    // Volume Profile narrative
    if close > vpVAH
        narrative := narrative + "Above VAH (breakout?). "
    else if close < vpVAL
        narrative := narrative + "Below VAL (breakdown?). "
    else
        narrative := narrative + "Inside value area. "
    
    // Key signals
    if bullCVDDiv
        narrative := narrative + "\nCVD BULLISH divergence! "
    if bearCVDDiv
        narrative := narrative + "\nCVD BEARISH divergence! "
    if bullAbsorption
        narrative := narrative + "\nBULL absorption detected! "
    if bearAbsorption
        narrative := narrative + "\nBEAR absorption detected! "
    if failedBOAbove
        narrative := narrative + "\nFailed breakout ABOVE! "
    if failedBOBelow
        narrative := narrative + "\nFailed breakout BELOW! "
    
    // Final recommendation
    if confluence >= i_confThreshold
        if marketStructure == "BULLISH" and discountZone
            narrative := narrative + "\n\nLOOKING FOR LONGS."
        else if marketStructure == "BEARISH" and premiumZone
            narrative := narrative + "\n\nLOOKING FOR SHORTS."
        else
            narrative := narrative + "\n\nWAIT for better zone."
    else
        narrative := narrative + "\n\nCONFLUENCE LOW (" + str.tostring(math.round(confluence)) + "%). WAIT."
    
    narrativeLabel := label.new(bar_index + 3, low - 3 * atr, narrative, 
                                color=color.new(color.black, 70), textcolor=color.white,
                                style=label.style_label_up, size=size.small, textalign=text.align_left)

// ============================================================================
// ALERTS
// ============================================================================

alertcondition(longSignal, title="OMEGA V3 LONG", message="OMEGA V3: LONG signal! Confluence: {{plot_0}}%")
alertcondition(shortSignal, title="OMEGA V3 SHORT", message="OMEGA V3: SHORT signal! Confluence: {{plot_0}}%")
alertcondition(bullCVDDiv, title="Bull CVD Divergence", message="OMEGA V3: Bullish CVD divergence detected!")
alertcondition(bearCVDDiv, title="Bear CVD Divergence", message="OMEGA V3: Bearish CVD divergence detected!")
alertcondition(bullAbsorption, title="Bull Absorption", message="OMEGA V3: Bullish absorption pattern detected!")
alertcondition(bearAbsorption, title="Bear Absorption", message="OMEGA V3: Bearish absorption pattern detected!")
alertcondition(failedBOAbove, title="Failed BO Above", message="OMEGA V3: Failed breakout above detected!")
alertcondition(failedBOBelow, title="Failed BO Below", message="OMEGA V3: Failed breakout below detected!")
alertcondition(bullishCHOCH, title="Bullish CHOCH", message="OMEGA V3: Bullish Change of Character!")
alertcondition(bearishCHOCH, title="Bearish CHOCH", message="OMEGA V3: Bearish Change of Character!")

// Plot confluence for alerts
plot(confluence, "Confluence", display=display.none)
